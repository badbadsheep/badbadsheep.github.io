---
/** 首屏演出原型 —— 独立页，验证满意后搬进 Hero.astro。 */
import '../../styles/tokens.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <title>首屏演出 · 原型</title>
    <style is:global>
      :root {
        color-scheme: light;
      }

      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: #fff;
        transition: background 0.01s;
      }

      body[data-phase='inverted'],
      body[data-phase='final'] {
        background: #000;
      }

      canvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
      }

      [data-trail] {
        z-index: 1;
        transition: opacity 0.6s ease;
      }

      [data-phys] {
        z-index: 2;
        transition: opacity 0.6s ease;
      }

      [data-text] {
        z-index: 3;
      }

      [data-tagline] {
        position: fixed;
        left: 50%;
        top: 56%;
        z-index: 4;
        transform: translateX(-50%);
        margin: 0;
        color: #fff;
        font-family: var(--f-mono, ui-monospace, monospace);
        font-size: 14px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        opacity: 0;
        transition: opacity 1.4s ease 0.5s;
      }

      [data-tagline].on {
        opacity: 0.72;
      }

      [data-below] {
        position: fixed;
        left: 50%;
        bottom: 32px;
        z-index: 4;
        transform: translateX(-50%);
        margin: 0;
        color: #555;
        font-family: ui-monospace, monospace;
        font-size: 12px;
        letter-spacing: 0.1em;
        opacity: 0;
        transition: opacity 1.4s ease 1s;
      }

      [data-below].on {
        opacity: 0.6;
      }

      [data-replay] {
        position: fixed;
        right: 16px;
        top: 16px;
        z-index: 9;
        padding: 6px 12px;
        border: 1px solid #ccc;
        background: rgba(255, 255, 255, 0.7);
        color: #333;
        font-family: ui-monospace, monospace;
        font-size: 12px;
        cursor: pointer;
      }

      body[data-phase='inverted'] [data-replay],
      body[data-phase='final'] [data-replay] {
        border-color: #444;
        background: rgba(0, 0, 0, 0.6);
        color: #ccc;
      }
    </style>
  </head>

  <body>
    <canvas data-trail aria-hidden="true"></canvas>
    <canvas data-phys aria-hidden="true"></canvas>
    <canvas data-text aria-hidden="true"></canvas>

    <p data-tagline>Welcome to my world ^^</p>
    <p data-below>↓ 原型占位 · 正式版这里接四栏目屏</p>
    <button data-replay type="button">重播</button>

    <script>
      import { mount } from '../../scripts/proto/hero-scene';

      mount(document.body);

      // 重播：清掉会话标记，带上 play=1 刷新
      document.querySelector('[data-replay]')?.addEventListener('click', () => {
        sessionStorage.removeItem('bbs:hero-played');
        const url = new URL(window.location.href);
        url.searchParams.set('play', '1');
        window.location.href = url.href;
      });
    </script>
  </body>
</html>
