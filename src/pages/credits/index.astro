---
import { render } from 'astro:content';
import Reading from '../../layouts/Reading.astro';
import { getPage } from '../../lib/content';

const page = await getPage('credits');
if (!page) throw new Error('缺少 src/content/pages/credits.md');
const { Content } = await render(page);
---

<Reading title={page.data.title} description={page.data.desc}>
  <header class="page-head">
    <p class="page-head__kicker">Credits</p>
    <h1 class="page-head__title">{page.data.title}</h1>
    {page.data.desc && <p class="page-head__desc">{page.data.desc}</p>}
  </header>

  <div class="prose">
    <Content />
  </div>
</Reading>
