---
/**
 * 右侧目录面板 + 手机端目录抽屉。
 *
 * 电脑端：面板（可拖宽度 + 左侧分隔线 + 拖拽手柄）→ 竖排居中 → 目录本体。
 * 宽度由 --toc-w 控制（reading.ts 拖动时改它，并写进 localStorage）。
 * 手柄中间那条竖线两侧加了 ← → 箭头，明示"这里可以左右拖"。
 *
 * 手机端（< 62rem）：电脑面板隐藏，左下角出现一个和右上角导航同尺寸的小方块
 * （列表图标，不是三道杠），点开从左侧滑出目录抽屉。抽屉用原生 <dialog>：
 * 焦点圈定、Esc / 返回手势关闭、页面 inert 都由浏览器负责（见 reading.ts）。
 * 图标用"带项目符号的列表"而不是三道杠，和右上角"栏目"区分开。
 *
 * 收录 h1–h4：只收 h2+h3 的话，正文里用 `#` 分节的文章会一个标题都收不到，
 * 目录看起来就像"坏了"。（文章标题本身来自 front matter，不在 headings 里，
 * 所以收录 h1 不会和标题重复。）
 */
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
/**
 * 过滤掉空标题：正文里写 `#### <sizeof>` 这类裸尖括号时，Astro 会把它当 HTML 标签，
 * 标题文本和 slug 都变成空 —— 目录里就会出现一条点不动的空白项。
 * 空文本 / 空 slug 直接不进目录。
 */
const items = headings.filter(
  (h) => h.depth >= 1 && h.depth <= 4 && h.text.trim().length > 0 && h.slug.length > 0
);
---

{
  items.length > 0 && (
    <>
      <aside class="toc-panel" data-toc-panel>
        <div
          class="toc-grip"
          data-toc-grip
          role="separator"
          aria-orientation="vertical"
          aria-label="拖动调整目录宽度，也可以聚焦后用左右方向键"
          tabindex="0"
        >
          <svg class="toc-grip__arrows" viewBox="0 0 18 12" width="18" height="12" aria-hidden="true">
            <path
              d="M6 6H1.5M4.3 3.4 1.6 6l2.7 2.6M12 6h4.5M13.7 3.4 16.4 6l-2.7 2.6"
              fill="none"
              stroke="currentColor"
              stroke-width="1.1"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </div>
        <div class="toc-panel__inner">
          <nav class="toc" aria-label="本文目录" data-toc>
            <p class="toc__label">目录</p>
            <ul>
              {items.map((h) => (
                <li class={`lvl-${h.depth}`}>
                  <a href={`#${h.slug}`} data-toc-link>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </aside>

      <button
        class="toc-toggle"
        type="button"
        data-toc-open
        aria-controls="bbs-toc"
        aria-expanded="false"
        aria-label="文章目录"
      >
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
          <path
            d="M2 3.5h1.3M5.4 3.5H14M2 8h1.3M5.4 8H14M2 12.5h1.3M5.4 12.5H14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="square"
          />
        </svg>
      </button>

      <dialog class="toc-sheet" id="bbs-toc" data-toc-sheet aria-labelledby="bbs-toc-title">
        <div class="toc-sheet__panel">
          <div class="toc-sheet__head">
            <p class="toc-sheet__title" id="bbs-toc-title">
              目录
            </p>
            <button class="toc-sheet__close" type="button" data-toc-close aria-label="关闭目录" autofocus>
              <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                <path d="M3 3l10 10M13 3L3 13" fill="none" stroke="currentColor" stroke-width="1.3" />
              </svg>
            </button>
          </div>
          <nav class="toc toc--sheet" aria-label="本文目录" data-toc>
            <ul>
              {items.map((h) => (
                <li class={`lvl-${h.depth}`}>
                  <a href={`#${h.slug}`} data-toc-link>
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </dialog>
    </>
  )
}
