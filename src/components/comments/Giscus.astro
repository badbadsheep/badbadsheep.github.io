---
/**
 * 评论区。只在 blog / note / story 的文章页出现，作品页没有。
 *
 * 四个 ID 来自 giscus.app，写进 .env 即可生效：
 *   PUBLIC_GISCUS_REPO=owner/repo
 *   PUBLIC_GISCUS_REPO_ID=…
 *   PUBLIC_GISCUS_CATEGORY=Announcements
 *   PUBLIC_GISCUS_CATEGORY_ID=…
 * 没配置时这里是一条说明，不会加载任何第三方脚本（本地开发也不会）。
 *
 * 真正的注入在 scripts/reading.ts：只有滚到评论区附近才加载 iframe。
 */
/**
 * 兜底值：线上实际在用的那四个公开 ID（本来就是公开参数，会原样出现在 HTML 里）。
 * 为什么要有兜底：.env 不进仓库，CI 里只能读仓库变量；变量没建的话线上就退回
 * "还没接上"的说明 —— 之前评论一直空着就是这条原因。env 仍然优先，换仓库不用改代码。
 */
const DEFAULTS = {
  repo: 'badbadsheep/badbadsheep.github.io',
  repoId: 'R_kgDOVDP-nA',
  category: 'Announcements',
  categoryId: 'DIC_kwDOVDP-nM4DID_p',
};

const repo = import.meta.env.PUBLIC_GISCUS_REPO || DEFAULTS.repo;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID || DEFAULTS.repoId;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY || DEFAULTS.category;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || DEFAULTS.categoryId;
const configured = Boolean(repo && repoId && categoryId);
---

<section class="comments" aria-labelledby="comments-title">
  <h2 class="comments__head" id="comments-title">评论</h2>

  {
    configured ? (
      <div
        data-giscus
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
      />
    ) : (
      <p class="comments__note">
        评论区还没接上。把 giscus 的四个 ID 写进 <code>.env</code>（<code>PUBLIC_GISCUS_*</code>），
        刷新就会出现在这里。
      </p>
    )
  }
</section>
