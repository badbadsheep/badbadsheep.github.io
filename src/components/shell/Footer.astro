---
/**
 * 页脚。两个版本内容**不一样**：
 *   · 门面版（首页）：只留版权、邮箱、GitHub、tagline。
 *     关于 / 归档 / RSS / 致谢 从首页撤掉了 —— 它们仍在抽屉里，也仍在文章页脚。
 *   · 阅读版（文章页）：保持完整的一套。
 *
 * 邮箱一律是「只展示」的纯文本，不做 mailto：它是个联系方式，不是按钮。
 * 想复制就手动选中复制。
 */
import { SITE } from '../../data/site';

interface Props {
  variant?: 'reading' | 'facade';
}

const { variant = 'reading' } = Astro.props;
const year = new Date().getFullYear();
---

{
  variant === 'facade' ? (
    <footer class="foot-facade">
      <div class="wrap">
        <div class="foot-facade__row">
          <span>
            © {year} {SITE.name}
          </span>
          <span class="foot-mail">{SITE.email}</span>
          <a href={`https://github.com/${SITE.github}`} rel="me noopener" target="_blank">
            GitHub
          </a>
          <span class="foot-facade__tag">{SITE.tagline}</span>
        </div>
      </div>
    </footer>
  ) : (
    <footer class="foot wrap">
      <span>
        © {year} {SITE.name}
      </span>
      <span class="foot-mail">{SITE.email}</span>
      <a href={`https://github.com/${SITE.github}`} rel="me noopener" target="_blank">
        GitHub
      </a>
      <span class="foot__spacer"></span>
      <span>{SITE.tagline}</span>
    </footer>
  )
}
