---
/**
 * 首页的一个栏目屏：栏目名 + 说明 + 5–6 个气泡 + 右下角 See More。
 * 空栏目只写一句话，别的东西一概不加。
 *
 * 底纹是 CSS 画的静态方形网格（见 facade.css 的 .screen），不用 JS。
 */
import type { Post, Work } from '../../lib/content';
import type { Section } from '../../data/sections';
import Bubble from './Bubble.astro';
import SeeMore from './SeeMore.astro';

interface Props {
  section: Section;
  posts?: Post[];
  works?: Work[];
  /** 每屏放几条 */
  limit?: number;
}

const { section, posts = [], works = [], limit = 6 } = Astro.props;
const isCollection = section.kind === 'collection';
const total = isCollection ? works.length : posts.length;
const shown = isCollection ? works.slice(0, limit) : posts.slice(0, limit);
---

<section class="screen" id={`s-${section.segment}`} aria-labelledby={`h-${section.segment}`}>
  <div class="screen__inner">
    <header class="screen__head">
      <h2 class="screen__mark" id={`h-${section.segment}`}>{section.mark}</h2>
      <span class="screen__idx">{section.index}</span>
      <p class="screen__desc">{section.desc}</p>
    </header>

    {
      shown.length === 0 ? (
        <div class="void">
          <p>未来，这里将繁花满地</p>
        </div>
      ) : (
        <div class="bubbles bubbles--rows">
          {isCollection
            ? (shown as Work[]).map((w) => (
                <Bubble
                  href={w.url}
                  layout="row"
                  mark={w.categoryName}
                  title={w.title}
                  meta={String(w.year)}
                />
              ))
            : (shown as Post[]).map((p) => (
                <Bubble
                  href={p.url}
                  layout="row"
                  mark={p.section.name}
                  title={p.title}
                  meta={p.dateISO}
                />
              ))}
        </div>
      )
    }
  </div>

  {total > 0 && <SeeMore href={section.url} />}
</section>
