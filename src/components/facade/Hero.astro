---
/**
 * 第一屏 —— 动效层【留空】，但接口与骨架已经就位。
 *
 * 现在看到的是纯 CSS 的静态几何构图。这不是临时占位：
 * 它同时也是 WebGL 不可用 / prefers-reduced-motion / 省流量模式下的降级画面，
 * 所以以后接上动效时，这一层要原样留着。
 *
 * ── 怎么接动效（等你示意图定了之后） ──────────────────────────────────
 *   1. 写一个场景模块，满足 src/scripts/art/index.ts 里的 Scene 接口
 *   2. 在 src/scripts/art/index.ts 的 REGISTRY 里登记它
 *   3. 其余不用动：tier 判定、DPR、resize、页面隐藏暂停、指针与滚动采样、
 *      webglcontextlost 降级、以及 <canvas data-art> 的挂载，都已经写好了
 *
 * 交互相关的文案与结构（大字、tagline、向下提示）在这里改。
 */
import { SITE } from '../../data/site';
import HeroArt from './HeroArt.astro';

const [first, ...rest] = ['badbad', 'sheep'];
---

<section class="hero" id="s-top" aria-labelledby="hero-title">
  <div class="hero__stage" aria-hidden="true">
    <div class="hero__geo">
      {/* 点阵底：.hero__geo::before */}
      <HeroArt />
    </div>
    {/* 动效层画在这里。现在它是空的，上面的矢量构图透上来。 */}
    <canvas class="hero__canvas" data-art></canvas>
  </div>

  <div class="hero__inner wrap">
    <h1 class="hero__title" id="hero-title">
      <span>{first}</span>
      {rest.map((line) => <span>{line}</span>)}
    </h1>
    <p class="hero__tag">{SITE.tagline}</p>
  </div>

  <script>
    import { mountHero } from '../../scripts/art';

    mountHero();

    /**
     * 首屏两套指针交互：
     *
     * ① 推开：几何构图轻轻向外让开，屏幕上最多 5px。
     *    每条线、方框、圆各自按"离指针越近推得越多"往反方向移位；点阵整体做轻微视差。
     *    注意：SVG 里的位移单位是 viewBox 单位，不是 CSS px（1440 宽下这张图被缩到
     *    0.681 倍），所以先按屏幕上的 5px 算，再除以缩放比换回去。
     *
     * ② 收缩：指针压到某条彩色线上，那条线从两端往指针下的那一点收回，0.5 秒收成一点，
     *    线本身的位置不动；指针一挪开，两端原路伸回原来的长度。
     *    · A 点 = 指针在该线上的垂足（跟着指针滑）
     *    · 同一条线上的多条线一起收
     *    · 命中判定永远按**原始几何**算 —— 否则线收成点之后就再也点不到了
     */
    const svg = document.querySelector<SVGSVGElement>('.hero__art');
    const geo = document.querySelector<HTMLElement>('.hero__geo');
    const hero = document.querySelector<HTMLElement>('.hero');

    if (svg && geo && hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const parts = [...svg.querySelectorAll<SVGGraphicsElement>('line, path')];
      const lineEls = [...svg.querySelectorAll<SVGLineElement>('.hero__art-lines line')];

      /** 收缩时长与命中半径（屏幕 px）。线宽固定 1.8px，命中带 ±5px。 */
      const COL_MS = 400;
      const TOL_PX = 6;

      /** 每条线的原始端点 + 收缩进度（0 完整 → 1 收成一点）+ 最近一次命中的 A 点 */
      const col = lineEls.map((el) => ({
        x1: Number(el.getAttribute('x1')),
        y1: Number(el.getAttribute('y1')),
        x2: Number(el.getAttribute('x2')),
        y2: Number(el.getAttribute('y2')),
        p: 0,
        ax: 0,
        ay: 0,
        hit: false,
      }));

      let frame = 0;
      let prev = 0;

      /** 把每条线按当前进度画出来：两端同时朝 A 点收 */
      const tick = (now: number) => {
        const dt = prev ? Math.min(64, now - prev) : 16;
        prev = now;
        let busy = false;

        lineEls.forEach((el, i) => {
          const s = col[i];
          const goal = s.hit ? 1 : 0;

          if (Math.abs(s.p - goal) > 0.0001) {
            const step = dt / COL_MS; // 走满 0→1 正好 0.5 秒
            s.p = s.p < goal ? Math.min(goal, s.p + step) : Math.max(goal, s.p - step);
            busy = true;
          }

          if (s.p <= 0) {
            el.setAttribute('x1', String(s.x1));
            el.setAttribute('y1', String(s.y1));
            el.setAttribute('x2', String(s.x2));
            el.setAttribute('y2', String(s.y2));
            return;
          }

          // smoothstep：收和放都不生硬
          const k = s.p * s.p * (3 - 2 * s.p);
          el.setAttribute('x1', String(s.x1 + (s.ax - s.x1) * k));
          el.setAttribute('y1', String(s.y1 + (s.ay - s.y1) * k));
          el.setAttribute('x2', String(s.x2 + (s.ax - s.x2) * k));
          el.setAttribute('y2', String(s.y2 + (s.ay - s.y2) * k));
        });

        if (busy) {
          frame = requestAnimationFrame(tick);
        } else {
          frame = 0;
          prev = 0;
        }
      };

      const kick = () => {
        if (!frame) {
          prev = 0;
          frame = requestAnimationFrame(tick);
        }
      };

      let queued = 0;

      const onMove = (e: PointerEvent) => {
        if (queued) return;
        queued = requestAnimationFrame(() => {
          queued = 0;
          const m = svg.getScreenCTM();
          if (!m) return;

          // ① 推开
          for (const el of parts) {
            const b = el.getBBox();
            const ux = b.x + b.width / 2;
            const uy = b.y + b.height / 2;
            const cx = m.a * ux + m.c * uy + m.e;
            const cy = m.b * ux + m.d * uy + m.f;
            const dx = cx - e.clientX;
            const dy = cy - e.clientY;
            const d = Math.hypot(dx, dy) || 1;
            const px = Math.max(0, 1 - d / 900) * 5; // 屏幕上最远 5px
            const u = px / (m.a || 1); // 换回 viewBox 单位
            el.style.transform = `translate(${((dx / d) * u).toFixed(2)}px, ${((dy / d) * u).toFixed(2)}px)`;
          }
          geo.style.setProperty('--grid-x', `${((e.clientX / innerWidth - 0.5) * -10).toFixed(2)}px`);
          geo.style.setProperty('--grid-y', `${((e.clientY / innerHeight - 0.5) * -10).toFixed(2)}px`);

          // ② 收缩：把指针换算到 viewBox 坐标，再逐条算点到线段的距离
          const pt = svg.createSVGPoint();
          pt.x = e.clientX;
          pt.y = e.clientY;
          const u = pt.matrixTransform(m.inverse());
          const tol = TOL_PX / (m.a || 1);

          lineEls.forEach((_, i) => {
            const s = col[i];
            const dx = s.x2 - s.x1;
            const dy = s.y2 - s.y1;
            const len2 = dx * dx + dy * dy || 1;
            const t = Math.max(0, Math.min(1, ((u.x - s.x1) * dx + (u.y - s.y1) * dy) / len2));
            const ax = s.x1 + dx * t;
            const ay = s.y1 + dy * t;
            const near = Math.hypot(u.x - ax, u.y - ay) <= tol;
            s.hit = near;
            if (near) {
              s.ax = ax;
              s.ay = ay;
            }
          });

          kick();
        });
      };

      hero.addEventListener('pointermove', onMove as EventListener);
      hero.addEventListener('pointerleave', () => {
        parts.forEach((el) => (el.style.transform = ''));
        geo.style.setProperty('--grid-x', '0px');
        geo.style.setProperty('--grid-y', '0px');
        col.forEach((s) => (s.hit = false));
        kick();
      });
    }
  </script>
</section>
