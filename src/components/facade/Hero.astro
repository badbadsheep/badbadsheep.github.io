---
/**
 * 第一屏 —— 动效层【留空】，但接口与骨架已经就位。
 *
 * 现在看到的是纯 CSS 的静态几何构图。这不是临时占位：
 * 它同时也是 WebGL 不可用 / prefers-reduced-motion / 省流量模式下的降级画面，
 * 所以以后接上动效时，这一层要原样留着。
 *
 * ── 怎么接动效（等你示意图定了之后） ──────────────────────────────────
 *   1. 写一个场景模块，满足 src/scripts/art/index.ts 里的 Scene 接口
 *   2. 在 src/scripts/art/index.ts 的 REGISTRY 里登记它
 *   3. 其余不用动：tier 判定、DPR、resize、页面隐藏暂停、指针与滚动采样、
 *      webglcontextlost 降级、以及 <canvas data-art> 的挂载，都已经写好了
 *
 * 交互相关的文案与结构（大字、tagline、向下提示）在这里改。
 */
import { SITE } from '../../data/site';

const [first, ...rest] = ['badbad', 'sheep'];
---

<section class="hero" id="s-top" aria-labelledby="hero-title">
  <div class="hero__stage" aria-hidden="true">
    <div class="hero__geo">
      <span class="hero__circle"></span>
      <span class="hero__bar hero__bar--h1"></span>
      <span class="hero__bar hero__bar--h2"></span>
      <span class="hero__bar hero__bar--v1"></span>
      <span class="hero__bar hero__bar--v2"></span>
      <span class="hero__block hero__block--1"></span>
      <span class="hero__block hero__block--2"></span>
    </div>
    {/* 动效层画在这里。现在它是空的，CSS 构图透上来。 */}
    <canvas class="hero__canvas" data-art></canvas>
  </div>

  <div class="hero__inner wrap">
    <h1 class="hero__title" id="hero-title">
      <span>{first}</span>
      {rest.map((line) => <span>{line}</span>)}
    </h1>
    <p class="hero__tag">{SITE.tagline}</p>
  </div>

  <script>
    import { mountHero } from '../../scripts/art';
    mountHero();

    /**
     * 指针靠近时，几何构图轻轻向外推开 —— 最大 5px。
     * 每个图形按"离指针越近推得越多"往反方向让开；点阵整体往反方向偏一点，
     * 形成轻微的视差。位移写在 translate 上，和原有定位互不干扰。
     */
    const geo = document.querySelector<HTMLElement>('.hero__geo');

    if (geo && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const parts = [...geo.querySelectorAll<HTMLElement>(':scope > span')];
      let base: { cx: number; cy: number }[] = [];
      let queued = 0;

      const measure = () => {
        parts.forEach((el) => (el.style.translate = ''));
        base = parts.map((el) => {
          const r = el.getBoundingClientRect();
          return { cx: r.left + r.width / 2, cy: r.top + r.height / 2 };
        });
      };

      const onMove = (e: PointerEvent) => {
        if (queued) return;
        queued = requestAnimationFrame(() => {
          queued = 0;
          parts.forEach((el, i) => {
            const dx = base[i].cx - e.clientX;
            const dy = base[i].cy - e.clientY;
            const d = Math.hypot(dx, dy) || 1;
            const k = Math.max(0, 1 - d / 900) * 5; // 最远 5px
            el.style.translate = `${((dx / d) * k).toFixed(2)}px ${((dy / d) * k).toFixed(2)}px`;
          });
          geo.style.setProperty('--grid-x', `${((e.clientX / innerWidth - 0.5) * -10).toFixed(2)}px`);
          geo.style.setProperty('--grid-y', `${((e.clientY / innerHeight - 0.5) * -10).toFixed(2)}px`);
        });
      };

      measure();
      window.addEventListener('resize', measure, { passive: true });
      document.querySelector('.hero')?.addEventListener('pointermove', onMove as EventListener);
      document.querySelector('.hero')?.addEventListener('pointerleave', () => {
        parts.forEach((el) => (el.style.translate = ''));
        geo.style.setProperty('--grid-x', '0px');
        geo.style.setProperty('--grid-y', '0px');
      });
    }
  </script>
</section>
