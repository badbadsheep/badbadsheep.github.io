---
/**
 * 全站外壳：head、主题预置、右上角四件套、抽屉、搜索层、页脚。
 *
 * 两个子布局（Facade / Reading）只是往里塞不同的版式 CSS 与 <slot />。
 * 样式分层见 SPEC 6.2：tokens + shell 在这里，门面/阅读各自的版式在子布局里。
 */
import '../styles/tokens.css';
import '../styles/shell.css';
import { SITE } from '../data/site';
import { SECTIONS } from '../data/sections';
import { getPosts, getWorks } from '../lib/content';
import NavCluster from '../components/shell/NavCluster.astro';
import Drawer from '../components/shell/Drawer.astro';
import SearchOverlay from '../components/shell/SearchOverlay.astro';
import Footer from '../components/shell/Footer.astro';

interface Props {
  /** 不含站名的页面标题 */
  title?: string;
  description?: string;
  /** 门面（首页、影像）：整体锁黑底 */
  facade?: boolean;
  /** 首页：启用第一屏吸附，导航一开始隐藏 */
  home?: boolean;
  /** 抽屉里要显示的计数 */
  variant?: 'reading' | 'facade';
  /** 分享卡片的类型：文章页传 article */
  type?: 'website' | 'article';
  /** 文章页用：发布日与标签 */
  published?: string;
  tags?: string[];
}

const {
  title,
  description,
  facade = false,
  home = false,
  variant = 'reading',
  type = 'website',
  published,
  tags = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const desc = description ?? SITE.description;
const canonical = new URL(Astro.url.pathname, SITE.url).href;

// 抽屉里每个栏目有多少条 —— 没有内容时不显示数字
const posts = await getPosts();
const works = await getWorks();
const counts: Record<string, number> = {};
for (const s of SECTIONS) {
  counts[s.key] = s.kind === 'collection' ? works.length : posts.filter((p) => p.section.key === s.key).length;
}
---

<!doctype html>
<html lang={SITE.lang} data-theme="dark" class:list={[{ 'is-home': home }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.png" sizes="any" />
    <link rel="icon" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/avatars/avatar.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} · RSS`}
      href={`${SITE.url}/feed_rss_created.xml`}
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    {type === 'article' && published && <meta property="article:published_time" content={published} />}
    {type === 'article' && <meta property="article:author" content={SITE.author} />}
    {type === 'article' && tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark light" />

    {/* Instrument Serif 是首屏大字用的字体，提前拉一下，省一个 RTT 的闪动 */}
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* 预置主题：必须内联、必须在样式之前，否则会闪一下白。
        与 scripts/shell.ts 读的是同一个键。没有存过偏好时默认深色。 */}
    <script is:inline>
      try {
        var v = localStorage.getItem('bbs:theme');
        document.documentElement.setAttribute('data-theme', v === 'light' ? 'light' : 'dark');
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    </script>
  </head>

  <body class:list={[{ 'is-facade': facade || variant === 'facade' }]}>
    <a class="skip" href="#main">跳到正文</a>

    <NavCluster home={home} />

    {/* 没有 JS 时，右上角那几个按钮全是死的（抽屉、搜索、明暗都要脚本）。
        所以这里给一条最朴素的导航带，保证无脚本也能走遍全站。 */}
    <noscript>
      <div class="nojs">
        <div class="wrap">
          <ul class="linklist">
            {
              SECTIONS.map((s) => (
                <li>
                  <a href={s.url}>{s.name}</a>
                </li>
              ))
            }
            <li>
              <a href="/archive/">归档</a>
            </li>
            <li>
              <a href="/about/">关于</a>
            </li>
            <li>
              <a href="/feed_rss_created.xml">RSS</a>
            </li>
          </ul>
        </div>
      </div>
    </noscript>

    <main id="main">
      <slot />
    </main>

    <Footer variant={variant} />

    <Drawer counts={counts} />
    <SearchOverlay />

    {/* 灯箱：结构常驻，逻辑在 scripts/reading.ts 里，点了才加载 */}
    <dialog class="lightbox" data-lightbox aria-label="查看大图">
      <button class="lightbox__close" type="button" data-lightbox-close aria-label="关闭">✕</button>
      <img alt="" data-lightbox-img />
    </dialog>

    <script>
      import '../scripts/shell';
    </script>
  </body>
</html>
