{
  "name": "badbadsheep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "纯静态个人站。Astro 构建，无框架运行时，无后端。",
  "homepage": "https://badbadsheep.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badbadsheep/badbadsheep.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/badbadsheep/badbadsheep.github.io/issues"
  },
  "author": "badbadsheep",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/subset-fonts.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "links": "node scripts/check-links.mjs",
    "images": "node scripts/check-images.mjs",
    "images:unused": "node scripts/check-images.mjs --unused",
    "fonts": "node scripts/subset-fonts.mjs",
    "verify": "node scripts/subset-fonts.mjs && node scripts/check-images.mjs && astro check && astro build && node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "7.4.0",
    "matter-js": "^0.20.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/matter-js": "^0.20.2",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3"
  }
}
