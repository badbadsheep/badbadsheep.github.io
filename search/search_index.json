34\u5c2c\u200b\u7684\u200b\u5730\u65b9\u200b\u3002 giscus \u200b\u7528\u200b GitHub Discussions \u200b\u5f53\u200b\u6570\u636e\u5e93\u200b\uff0c\u200b\u628a\u200b\u8fd9\u4ef6\u200b\u4e8b\u200b\u53d8\u6210\u200b\u4e86\u200b\u300c\u200b\u8d34\u200b\u4e00\u6bb5\u200b script\u300d\u3002</p>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#\u5b83\u662f\u600e\u4e48\u5de5\u4f5c\u7684","title":"\u5b83\u200b\u662f\u200b\u600e\u4e48\u200b\u5de5\u4f5c\u200b\u7684","text":"<p>giscus \u200b\u672c\u8d28\u200b\u4e0a\u200b\u662f\u200b\u4e00\u4e2a\u200b\u524d\u7aef\u200b\u5c0f\u7ec4\u200b\u4ef6\u200b\uff1a</p> <ol> <li>\u200b\u9875\u9762\u200b\u52a0\u8f7d\u200b\u65f6\u200b\u8bf7\u6c42\u200b <code>giscus.app/client.js</code></li> <li>\u200b\u7ec4\u4ef6\u200b\u6839\u636e\u200b\u914d\u7f6e\u200b\uff08\u200b\u6bd4\u5982\u200b\u5f53\u524d\u200b\u9875\u9762\u200b\u8def\u5f84\u200b\uff09\u200b\u53bb\u200b\u4f60\u200b\u7684\u200b\u4ed3\u5e93\u200b\u91cc\u200b\u627e\u200b\u5bf9\u5e94\u200b\u7684\u200b Discussion</li> <li>\u200b\u627e\u5230\u200b\u5c31\u200b\u628a\u200b\u8bc4\u8bba\u200b\u533a\u200b\u6e32\u67d3\u200b\u51fa\u6765\u200b\uff0c\u200b\u627e\u200b\u4e0d\u5230\u200b\u5c31\u200b\u521b\u5efa\u200b\u4e00\u4e2a\u200b</li> </ol> <p>\u200b\u4e5f\u5c31\u662f\u8bf4\u200b\uff0c\u200b\u6bcf\u7bc7\u200b\u6587\u7ae0\u200b\u5bf9\u5e94\u200b\u4e00\u4e2a\u200b Discussion \u200b\u5e16\u5b50\u200b\uff0c\u200b\u8bc4\u8bba\u200b\u7684\u200b\u589e\u5220\u200b\u6539\u67e5\u200b\u5168\u90e8\u200b\u8d70\u200b GitHub \u200b\u7684\u200b API\u3002 \u200b\u4f60\u200b\u7684\u200b\u535a\u5ba2\u200b\u672c\u8eab\u200b\u4f9d\u7136\u200b\u662f\u200b\u7eaf\u200b\u9759\u6001\u200b\u7684\u200b\uff0c\u200b\u4e00\u4e2a\u200b\u5b57\u8282\u200b\u7684\u200b\u540e\u200b\u7aef\u200b\u4ee3\u7801\u200b\u90fd\u200b\u4e0d\u200b\u9700\u8981\u200b\u5199\u200b\u3002</p>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#\u4e00\u6b21\u6027\u914d\u7f6e","title":"\u4e00\u6b21\u6027\u200b\u914d\u7f6e","text":"","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#1-\u6253\u5f00-discussions","title":"1. \u200b\u6253\u5f00\u200b Discussions","text":"<p>\u200b\u4ed3\u5e93\u200b \u2192 Settings \u2192 General \u2192 Features \u2192 \u200b\u52fe\u9009\u200b Discussions\u3002</p>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#2-\u5efa\u7acb\u5206\u7c7b","title":"2. \u200b\u5efa\u7acb\u200b\u5206\u7c7b","text":"<p>\u200b\u5728\u200b Discussions \u200b\u9875\u9762\u200b\u5de6\u4fa7\u200b\u627e\u5230\u200b\u5206\u7c7b\u7ba1\u7406\u200b\uff0c\u200b\u65b0\u5efa\u200b\u4e00\u4e2a\u200b\u5206\u7c7b\u200b\uff08\u200b\u6bd4\u5982\u200b <code>Comments</code>\uff09\uff0c \u200b\u7c7b\u578b\u200b\u9009\u200b Announcements \u200b\u6bd4\u8f83\u200b\u5408\u9002\u200b \u2014\u2014 \u200b\u53ea\u6709\u200b\u7ef4\u62a4\u8005\u200b\u80fd\u200b\u53d1\u8d77\u200b\u65b0\u5e16\u200b\uff0c\u200b\u8bfb\u8005\u200b\u53ea\u80fd\u200b\u56de\u590d\u200b\uff0c \u200b\u53ef\u4ee5\u200b\u9632\u6b62\u200b\u9875\u9762\u200b\u4e0a\u200b\u5192\u200b\u51fa\u200b\u4e00\u5806\u200b\u7a7a\u200b\u8ba8\u8bba\u200b\u3002</p>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#3-\u5b89\u88c5-giscus-app","title":"3. \u200b\u5b89\u88c5\u200b giscus App","text":"<p>\u200b\u8bbf\u95ee\u200b https://github.com/apps/giscus\uff0c\u200b\u9009\u62e9\u200b Only select repositories\uff0c \u200b\u52fe\u9009\u200b\u4f60\u200b\u7684\u200b\u535a\u5ba2\u200b\u4ed3\u5e93\u200b\u3002</p>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#4-\u751f\u6210\u4e24\u4e2a-id","title":"4. \u200b\u751f\u6210\u200b\u4e24\u4e2a\u200b ID","text":"<p>\u200b\u6253\u5f00\u200b https://giscus.app/zh-CN\uff0c\u200b\u586b\u5165\u200b\u4ed3\u5e93\u200b\u540d\u200b\uff0c\u200b\u9009\u200b\u597d\u200b\u5206\u7c7b\u200b\u4e0e\u200b\u6620\u5c04\u200b\u65b9\u5f0f\u200b\uff0c \u200b\u9875\u9762\u200b\u4e0b\u65b9\u200b\u4f1a\u200b\u751f\u6210\u200b\u4e00\u6bb5\u200b\u914d\u7f6e\u200b\uff0c\u200b\u5176\u4e2d\u200b\u9700\u8981\u200b\u7684\u200b\u5c31\u662f\u200b\uff1a</p> <pre><code>data-repo-id=\"R_kgDOxxxxxxx\"\ndata-category-id=\"DIC_kwDOxxxxxxxx\"\n</code></pre> <p>\u200b\u628a\u200b\u8fd9\u200b\u4e24\u4e2a\u200b\u503c\u200b\u8fde\u540c\u200b\u4ed3\u5e93\u200b\u540d\u200b\u4e00\u8d77\u200b\u586b\u8fdb\u200b <code>mkdocs.yml</code>\uff1a</p> <pre><code>extra:\n  giscus:\n    enabled: true\n    repo: \"your-name/your-name.github.io\"\n    repo_id: \"R_kgDOxxxxxxx\"\n    category: \"Comments\"\n    category_id: \"DIC_kwDOxxxxxxxx\"\n    mapping: pathname\n</code></pre>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#\u5173\u4e8e-mapping","title":"\u5173\u4e8e\u200b mapping","text":"<p><code>mapping</code> \u200b\u51b3\u5b9a\u200b\u300c\u200b\u54ea\u4e2a\u200b\u9875\u9762\u200b\u7b97\u200b\u540c\u4e00\u200b\u7bc7\u6587\u7ae0\u200b\u300d\uff0c\u200b\u5e38\u7528\u200b\u7684\u200b\u4e09\u79cd\u200b\uff1a</p> \u200b\u53d6\u503c\u200b \u200b\u4f9d\u636e\u200b \u200b\u9002\u7528\u200b\u573a\u666f\u200b <code>pathname</code> \u200b\u9875\u9762\u200b\u8def\u5f84\u200b \u200b\u6700\u7a33\u200b\uff0c\u200b\u6539\u200b\u6807\u9898\u200b\u4e0d\u200b\u5f71\u54cd\u200b\u8bc4\u8bba\u200b <code>title</code> \u200b\u9875\u9762\u200b\u6807\u9898\u200b \u200b\u6539\u200b\u6807\u9898\u200b\u4f1a\u200b\u5bfc\u81f4\u200b\u8bc4\u8bba\u200b\u300c\u200b\u4e22\u5931\u200b\u300d <code>og:title</code> Open Graph \u200b\u6807\u9898\u200b \u200b\u9700\u8981\u200b\u989d\u5916\u200b\u914d\u7f6e\u200b <p>\u200b\u63a8\u8350\u200b pathname</p> <p>\u200b\u53ea\u8981\u200b\u4e0d\u6539\u200b\u6587\u7ae0\u200b\u7684\u200b\u6c38\u4e45\u200b\u94fe\u63a5\u200b\uff0c\u200b\u8bc4\u8bba\u200b\u5c31\u200b\u4e0d\u4f1a\u200b\u9519\u4f4d\u200b\u3002 \u200b\u7ad9\u70b9\u200b\u6362\u200b\u57df\u540d\u200b\u65f6\u200b\u9700\u8981\u200b\u6ce8\u610f\u200b\u8def\u5f84\u200b\u662f\u5426\u200b\u4fdd\u6301\u4e00\u81f4\u200b\u3002</p>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#\u4e24\u4e2a\u5b9e\u73b0\u7ec6\u8282","title":"\u4e24\u4e2a\u200b\u5b9e\u73b0\u200b\u7ec6\u8282","text":"","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#\u6df1\u8272\u6a21\u5f0f\u8981\u8ddf\u7740\u6362","title":"\u6df1\u8272\u200b\u6a21\u5f0f\u200b\u8981\u200b\u8ddf\u7740\u200b\u6362","text":"<p>giscus \u200b\u7684\u200b iframe \u200b\u4e0d\u4f1a\u200b\u81ea\u52a8\u200b\u611f\u77e5\u200b\u4e3b\u9898\u200b\uff0c\u200b\u9700\u8981\u200b\u5728\u200b\u4e3b\u9898\u200b\u5207\u6362\u200b\u65f6\u200b\u624b\u52a8\u200b\u901a\u77e5\u200b\u5b83\u200b\uff1a</p> <pre><code>const frame = document.querySelector(\"iframe.giscus-frame\");\nframe.contentWindow.postMessage(\n  { giscus: { setConfig: { theme: \"dark_dimmed\" } } },\n  \"https://giscus.app\"\n);\n</code></pre> <p><code>docs/javascripts/extra.js</code> \u200b\u91cc\u200b\u5df2\u7ecf\u200b\u7528\u200b <code>MutationObserver</code> \u200b\u76d1\u542c\u200b <code>body[data-md-color-scheme]</code> \u200b\u7684\u200b\u53d8\u5316\u200b\uff0c\u200b\u81ea\u52a8\u200b\u5b8c\u6210\u200b\u8fd9\u4ef6\u200b\u4e8b\u200b\u3002</p>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#\u4e0d\u8981\u5f00-instant-\u5bfc\u822a","title":"\u4e0d\u8981\u200b\u5f00\u200b instant \u200b\u5bfc\u822a","text":"<p>\u200b\u5982\u679c\u200b\u542f\u7528\u200b\u4e86\u200b <code>navigation.instant</code>\uff0c\u200b\u9875\u9762\u200b\u5207\u6362\u200b\u4e0d\u4f1a\u200b\u91cd\u65b0\u200b\u6267\u884c\u200b <code>&lt;script&gt;</code>\uff0c \u200b\u8bc4\u8bba\u200b\u533a\u200b\u5c31\u200b\u53ea\u4f1a\u200b\u51fa\u73b0\u200b\u5728\u200b\u7b2c\u4e00\u6b21\u200b\u8fdb\u5165\u200b\u7684\u200b\u90a3\u200b\u4e00\u9875\u200b\u3002\u200b\u8981\u4e48\u200b\u5173\u6389\u200b\u5b83\u200b\uff0c\u200b\u8981\u4e48\u200b\u624b\u52a8\u200b\u91cd\u65b0\u200b\u6ce8\u5165\u200b\u811a\u672c\u200b \u2014\u2014 \u200b\u5bf9\u200b\u535a\u5ba2\u200b\u6765\u8bf4\u200b\uff0c\u200b\u76f4\u63a5\u200b\u5173\u6389\u200b\u66f4\u200b\u7701\u5fc3\u200b\u3002</p>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#\u6ca1\u6709-github-\u8d26\u53f7\u7684\u8bfb\u8005\u600e\u4e48\u529e","title":"\u6ca1\u6709\u200b GitHub \u200b\u8d26\u53f7\u200b\u7684\u200b\u8bfb\u8005\u200b\u600e\u4e48\u529e","text":"<p>\u200b\u8fd9\u200b\u662f\u200b\u4e2a\u200b\u771f\u5b9e\u200b\u7684\u200b\u53d6\u820d\u200b\u3002\u200b\u53ef\u4ee5\u200b\u4fdd\u7559\u200b\u4e00\u4e2a\u200b\u515c\u5e95\u200b\u6e20\u9053\u200b\uff1a</p> <ul> <li>\u200b\u9875\u811a\u200b\u653e\u200b\u4e00\u4e2a\u200b\u90ae\u7bb1\u200b\u94fe\u63a5\u200b</li> <li>\u200b\u5728\u200b\u6587\u7ae0\u200b\u5e95\u90e8\u200b\u6ce8\u660e\u200b\u300c\u200b\u4e5f\u200b\u53ef\u4ee5\u200b\u901a\u8fc7\u200b\u90ae\u4ef6\u200b\u544a\u8bc9\u200b\u6211\u200b\u300d</li> </ul> <p>\u200b\u6211\u200b\u5728\u200b <code>mkdocs.yml</code> \u200b\u7684\u200b <code>extra.social</code> \u200b\u91cc\u200b\u653e\u200b\u4e86\u200b\u4e00\u4e2a\u200b\u90ae\u4ef6\u200b\u56fe\u6807\u200b\uff0c\u200b\u5c31\u662f\u200b\u8fd9\u4e2a\u200b\u7528\u9014\u200b\u3002</p>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2025/01/20/comments-with-giscus/#\u5c0f\u7ed3","title":"\u5c0f\u7ed3","text":"<p>giscus \u200b\u4e0d\u662f\u200b\u6700\u200b\u5f00\u653e\u200b\u7684\u200b\u8bc4\u8bba\u200b\u65b9\u6848\u200b\uff0c\u200b\u4f46\u200b\u5b83\u200b\u628a\u200b\u300c\u200b\u514d\u8fd0\u7ef4\u200b\u300d\u200b\u548c\u200b\u300c\u200b\u6570\u636e\u200b\u81ea\u6709\u200b\u300d\u200b\u8fd9\u200b\u4e24\u4ef6\u4e8b\u200b\u540c\u65f6\u200b\u505a\u5230\u200b\u4e86\u200b\u3002 \u200b\u5bf9\u4e8e\u200b\u6258\u7ba1\u200b\u5728\u200b GitHub \u200b\u4e0a\u200b\u7684\u200b\u535a\u5ba2\u200b\uff0c\u200b\u5f88\u96be\u200b\u627e\u5230\u200b\u66f4\u200b\u5408\u9002\u200b\u7684\u200b\u7ec4\u5408\u200b\u3002</p>","tags":["giscus","GitHub Discussions","\u8bc4\u8bba\u7cfb\u7edf"]},{"location":"blog/2026/10/10/the-born-of-badbadblog/","title":"\u8fd9\u4e2a\u200b\u7f51\u7ad9\u200b\u8bde\u751f\u200b\u7684\u200b\u7a00\u91cc\u7cca\u6d82","text":"\ud83d\udcc4 \u200b\u7ea6\u200b 236 \u200b\u5b57\u200b\u23f1\ufe0f \u200b\u9605\u8bfb\u200b\u7ea6\u200b 1 \u200b\u5206\u949f\u200b <p>\u200b\u7a81\u7136\u200b\u60f3\u8981\u200b\u4e00\u4e2a\u200b\u81ea\u5df1\u200b\u7684\u200b\u7f51\u7ad9\u200b\uff01</p> <p>\u200b\u611f\u89c9\u200b\u539f\u56e0\u200b\u5f88\u591a\u200b\u2014\u2014\u200b\u5341\u6708\u5e95\u200bctf\u200b\u65b0\u751f\u200b\u8d5b\u200b\uff0c\u200b\u80fd\u200b\u4e0a\u4f20\u200b\u4fdd\u5b58\u200bwp\uff0c\u200b\u611f\u89c9\u200b\u6bd4\u200bword\u200b\u6587\u6863\u200b\u9ad8\u7ea7\u200b\uff1b\u200b\u81ea\u5df1\u200b\u7684\u200b\u7f51\u7ad9\u200b\uff0c\u200b\u4e00\u79cd\u200b\u83ab\u540d\u200b\u7684\u200b\u62e5\u6709\u200b\u611f\u200b\uff0c\u200b\u5fc3\u91cc\u200b\u6696\u6696\u7684\u200b\uff08\uff1f\uff1b\u200b\u80cc\u9760\u200bgithub\u200b\u5927\u5c71\u200b\uff0c\u200b\u8fd9\u4e9b\u200b\u6587\u5b57\u200b\u5927\u62b5\u200b\u80fd\u200b\u957f\u5b58\u200b\uff0c\u200b\u8d5b\u535a\u200b\u6c38\u751f\u200b\u5c5e\u5b9e\u200b\u662f\u200b...</p> <p>\u200b\u5948\u4f55\u200b\u4e0d\u4f1a\u200b\u4ee3\u7801\u200b\uff0c\u200b\u7f51\u7ad9\u200b\u642d\u5efa\u200b\u4e00\u65e0\u6240\u77e5\u200b\uff0c\u200b\u53ea\u80fd\u200b\u8bf7\u200b\u5403\u767d\u996d\u200b\u7684\u200b\u5927\u80a5\u9c7c\u200b\u3002\u200b\u8017\u8d39\u200b\u4e86\u200b\u4e00\u6574\u5929\u200b+6.79\uffe5\uff0c\u200b\u52c9\u5f3a\u200b\u6574\u51fa\u200b\u4e00\u4e2a\u200b\u6210\u54c1\u200b\u3002</p> <p></p> <p>\u200b\u7528\u200b\u8d77\u6765\u200b\u5f88\u200b\u5fc3\u865a\u200b\uff0c\u200b\u4e0d\u200b\u61c2\u200b\u6280\u672f\u200b\uff0c\u200b\u5f92\u7136\u200b\u8d21\u732e\u200b\u94b1\u8d22\u200b\u5c31\u200b\u83b7\u5f97\u200b\u7684\u200b\u4ee3\u7801\u200b\u4eff\u4f5b\u200b\u4e0d\u77e5\u6240\u4e91\u200b\u7684\u200b\u5609\u8c6a\u200b\uff1b\u200b\u7528\u200b\u8d77\u6765\u200b\u4e5f\u200b\u5f88\u200b\u522b\u626d\u200b\uff0c\u200b\u600e\u4e48\u200b\u5199\u6587\u7ae0\u200b\u8fde\u200b\u4e2a\u200bui\u200b\u754c\u9762\u200b\u4e5f\u200b\u6ca1\u6709\u200b\uff0c\u200b\u8fd8\u5206\u200b\u4e0d\u4e86\u200b\u81ea\u7136\u6bb5\u200b\uff0c\u200b\u914d\u4e2a\u200b\u56fe\u200b\u8c03\u8bd5\u200b\u4ee3\u7801\u200b\u4f3c\u7684\u200b\uff1b\u200b\u4f46\u7528\u200b\u8d77\u6765\u200b\u4e5f\u200b\u655d\u5e1a\u81ea\u73cd\u200b\uff0c\u200b\u867d\u8bf4\u200bhuaihuo\u200b\u4e1c\u897f\u200b\uff0c\u200b\u4ee5\u540e\u200b\u6162\u6162\u200b\u4fee\u200b\u603b\u4f1a\u200b\u597d\u7528\u200b\u8d77\u6765\u200b\u5427\u200b\u3002</p> <p>yeah~<sub>\u200b\u5c0f\u58f0\u200b\u5e86\u795d\u200b\u8fd9\u4e2a\u200b\u7b28\u62d9\u200b\u7684\u200b\u5c0f\u200b\u7f51\u7ad9\u200b\u8bde\u751f\u200b</sub></p>","tags":["\u5403\u767d\u996d\u7684\u84dd\u8272\u5927\u80a5\u9c7c"]},{"location":"notes/","title":"\u7b14\u8bb0","text":"\ud83d\udcc4 \u200b\u7ea6\u200b 61 \u200b\u5b57\u200b\u23f1\ufe0f \u200b\u9605\u8bfb\u200b\u7ea6\u200b 1 \u200b\u5206\u949f\u200b <p>\u200b\u8fd9\u91cc\u200b\u653e\u6bd4\u200b\u535a\u5ba2\u200b\u66f4\u200b\u96f6\u788e\u200b\u3001\u200b\u4f46\u4f1a\u200b\u6301\u7eed\u200b\u66f4\u65b0\u200b\u7684\u200b\u5185\u5bb9\u200b\uff1a\u200b\u73af\u5883\u200b\u914d\u7f6e\u200b\u3001\u200b\u5de5\u5177\u200b\u7528\u6cd5\u200b\u3001\u200b\u901f\u67e5\u8868\u200b\u3002 \u200b\u548c\u200b\u535a\u5ba2\u200b\u7684\u200b\u533a\u522b\u200b\u662f\u200b \u2014\u2014 \u200b\u535a\u5ba2\u200b\u5199\u200b\u300c\u200b\u4e00\u6b21\u6027\u200b\u7684\u200b\u5b8c\u6574\u200b\u6545\u4e8b\u200b\u300d\uff0c\u200b\u7b14\u8bb0\u200b\u5199\u200b\u300c\u200b\u4f1a\u200b\u53cd\u590d\u200b\u56de\u6765\u200b\u67e5\u200b\u7684\u200b\u4e1c\u897f\u200b\u300d\u3002</p>"},{"location":"notes/dev-setup/","title":"\u4ece\u200b\u96f6\u200b\u642d\u200b\u597d\u200b\u672c\u5730\u200b\u5199\u4f5c\u200b\u73af\u5883","text":"\ud83d\udcc4 \u200b\u7ea6\u200b 327 \u200b\u5b57\u200b\u23f1\ufe0f \u200b\u9605\u8bfb\u200b\u7ea6\u200b 1 \u200b\u5206\u949f\u200b <p>\u200b\u76ee\u6807\u200b\uff1a\u200b\u5728\u200b\u4e00\u53f0\u200b\u5168\u65b0\u200b\u7684\u200b Windows \u200b\u673a\u5668\u200b\u4e0a\u200b\uff0c\u200b\u628a\u200b\u300c\u200b\u5199\u6587\u7ae0\u200b \u2192 \u200b\u672c\u5730\u200b\u9884\u89c8\u200b \u2192 \u200b\u63a8\u9001\u200b\u53d1\u5e03\u200b\u300d\u200b\u8fd9\u6761\u200b\u94fe\u200b\u8dd1\u200b\u901a\u200b\u3002</p>","tags":["\u73af\u5883\u914d\u7f6e","MkDocs"]},{"location":"notes/dev-setup/#\u9700\u8981\u7684\u4e1c\u897f","title":"\u9700\u8981\u200b\u7684\u200b\u4e1c\u897f","text":"\u5de5\u5177\u200b \u200b\u7528\u9014\u200b \u200b\u68c0\u67e5\u200b\u547d\u4ee4\u200b Git \u200b\u7248\u672c\u200b\u7ba1\u7406\u200b <code>git --version</code> Python 3.9+ \u200b\u6784\u5efa\u200b\u7ad9\u70b9\u200b <code>python --version</code> VS Code \u200b\u5199\u4f5c\u200b\u4e0e\u200b\u9884\u89c8\u200b \u2014","tags":["\u73af\u5883\u914d\u7f6e","MkDocs"]},{"location":"notes/dev-setup/#\u4e00\u6b21\u6027\u5b89\u88c5","title":"\u4e00\u6b21\u6027\u200b\u5b89\u88c5","text":"<pre><code>git clone https://github.com/your-name/your-name.github.io.git\ncd your-name.github.io\n\npython -m venv .venv\n.venv\\Scripts\\python -m pip install -r requirements.txt\n</code></pre> <p>\u200b\u4e3a\u4ec0\u4e48\u200b\u8981\u200b\u7528\u200b\u865a\u62df\u73af\u5883\u200b</p> <p>\u200b\u7ad9\u70b9\u200b\u7684\u200b\u6784\u5efa\u200b\u4f9d\u8d56\u200b\uff08MkDocs\u3001\u200b\u63d2\u4ef6\u200b\uff09\u200b\u548c\u200b\u7cfb\u7edf\u200b\u91cc\u200b\u7684\u200b\u5176\u5b83\u200b Python \u200b\u5305\u200b\u4e92\u4e0d\u200b\u5e72\u6270\u200b\uff0c \u200b\u5c06\u6765\u200b\u5347\u7ea7\u200b\u6216\u200b\u5220\u6389\u200b\u6574\u7ad9\u200b\u65f6\u200b\u4e5f\u200b\u4e0d\u4f1a\u200b\u7559\u4e0b\u200b\u5783\u573e\u200b\u3002</p>","tags":["\u73af\u5883\u914d\u7f6e","MkDocs"]},{"location":"notes/dev-setup/#\u65e5\u5e38\u5199\u4f5c\u6d41\u7a0b","title":"\u65e5\u5e38\u200b\u5199\u4f5c\u200b\u6d41\u7a0b","text":"<pre><code># 1. \u200b\u8d77\u200b\u4e00\u4e2a\u200b\u672c\u5730\u200b\u9884\u89c8\u200b\u670d\u52a1\u200b\uff08\u200b\u9ed8\u8ba4\u200b http://127.0.0.1:8000\uff09\n.venv\\Scripts\\mkdocs serve\n\n# 2. \u200b\u53e6\u5f00\u200b\u4e00\u4e2a\u200b\u7ec8\u7aef\u200b\uff0c\u200b\u65b0\u5efa\u200b\u6587\u7ae0\u200b\u9aa8\u67b6\u200b\npython scripts/new_post.py \"\u200b\u6587\u7ae0\u200b\u6807\u9898\u200b\" --category \u200b\u6298\u817e\u200b\u8bb0\u5f55\u200b\n\n# 3. \u200b\u5199\u200b\u5b8c\u540e\u200b\u63a8\u9001\u200b\u5230\u200b\u8fdc\u7aef\u200b\ngit add -A\ngit commit -m \"post: \u200b\u6587\u7ae0\u200b\u6807\u9898\u200b\"\ngit push\n</code></pre> <p>\u200b\u63a8\u9001\u200b\u4e4b\u540e\u200b\u5927\u7ea6\u200b\u4e00\u5206\u949f\u200b\uff0cGitHub Actions \u200b\u4f1a\u200b\u5b8c\u6210\u200b\u6784\u5efa\u200b\u5e76\u200b\u53d1\u5e03\u200b\u3002</p>","tags":["\u73af\u5883\u914d\u7f6e","MkDocs"]},{"location":"notes/dev-setup/#vs-code-\u63a8\u8350\u914d\u7f6e","title":"VS Code \u200b\u63a8\u8350\u200b\u914d\u7f6e","text":"<p>\u200b\u5728\u200b <code>.vscode/settings.json</code> \u200b\u91cc\u200b\u52a0\u4e0a\u200b\uff1a</p> <pre><code>{\n  \"files.trimTrailingWhitespace\": true,\n  \"files.insertFinalNewline\": true,\n  \"[markdown]\": {\n    \"editor.wordWrap\": \"on\",\n    \"editor.quickSuggestions\": { \"other\": true, \"comments\": false, \"strings\": true }\n  }\n}\n</code></pre> <p>\u200b\u518d\u88c5\u200b\u4e24\u4e2a\u200b\u63d2\u4ef6\u200b\u5c31\u591f\u200b\u4e86\u200b\uff1aMarkdown All in One\uff08\u200b\u5feb\u6377\u952e\u200b\u4e0e\u200b\u76ee\u5f55\u200b\uff09\u200b\u548c\u200b YAML\uff08front matter \u200b\u8bed\u6cd5\u200b\u6821\u9a8c\u200b\uff09\u3002</p>","tags":["\u73af\u5883\u914d\u7f6e","MkDocs"]},{"location":"notes/dev-setup/#\u5e38\u89c1\u95ee\u9898","title":"\u5e38\u89c1\u95ee\u9898","text":"\u6784\u5efa\u200b\u62a5\u9519\u200b <code>Config value 'plugins': The \\\"xxx\\\" plugin is not installed</code> <p>\u200b\u4f9d\u8d56\u200b\u6ca1\u88c5\u5168\u200b\u3002\u200b\u91cd\u65b0\u200b\u6267\u884c\u200b <code>.venv\\Scripts\\python -m pip install -r requirements.txt</code>\u3002</p> \u200b\u672c\u5730\u200b\u80fd\u200b\u770b\u5230\u200b\u56fe\u7247\u200b\uff0c\u200b\u90e8\u7f72\u200b\u540e\u200b 404 <p>\u200b\u591a\u534a\u200b\u662f\u200b\u7528\u200b\u4e86\u200b\u7edd\u5bf9\u8def\u5f84\u200b\u3002\u200b\u7ad9\u70b9\u200b\u90e8\u7f72\u200b\u5728\u200b <code>\u200b\u7528\u6237\u540d\u200b.github.io/\u200b\u4ed3\u5e93\u200b\u540d\u200b/</code> \u200b\u8fd9\u79cd\u200b\u5b50\u200b\u8def\u5f84\u200b\u4e0b\u65f6\u200b\uff0c \u200b\u7edd\u5bf9\u8def\u5f84\u200b\u4f1a\u200b\u6307\u5411\u200b\u57df\u540d\u200b\u6839\u76ee\u5f55\u200b\u3002\u200b\u6539\u7528\u200b\u76f8\u5bf9\u8def\u5f84\u200b\uff0c\u200b\u6216\u200b\u5728\u200b <code>mkdocs.yml</code> \u200b\u4e2d\u200b\u6b63\u786e\u200b\u8bbe\u7f6e\u200b <code>site_url</code>\u3002</p> \u200b\u641c\u7d22\u200b\u4e2d\u6587\u200b\u6ca1\u6709\u200b\u7ed3\u679c\u200b <p>\u200b\u7f3a\u5c11\u200b\u4e2d\u6587\u200b\u5206\u200b\u8bcd\u5e93\u200b\u3002\u200b\u786e\u8ba4\u200b <code>requirements.txt</code> \u200b\u91cc\u200b\u6709\u200b <code>jieba</code>\uff0c\u200b\u5e76\u4e14\u200b <code>plugins.search.lang</code> \u200b\u4e2d\u200b\u5305\u542b\u200b <code>zh</code>\u3002</p> \u200b\u63a8\u9001\u200b\u540e\u200b Actions \u200b\u5931\u8d25\u200b\uff0c\u200b\u65e5\u5fd7\u200b\u663e\u793a\u200b 403 <p>\u200b\u68c0\u67e5\u200b\u5de5\u4f5c\u200b\u6d41\u200b\u7684\u200b <code>permissions</code> \u200b\u662f\u5426\u200b\u5305\u542b\u200b <code>pages: write</code> \u200b\u4e0e\u200b <code>id-token: write</code>\uff0c \u200b\u4ee5\u53ca\u200b\u4ed3\u5e93\u200b Settings \u2192 Pages \u200b\u7684\u200b Source \u200b\u662f\u5426\u200b\u9009\u6210\u200b\u4e86\u200b GitHub Actions\u3002</p>","tags":["\u73af\u5883\u914d\u7f6e","MkDocs"]},{"location":"notes/git-workflow/","title":"\u6211\u200b\u7684\u200b Git \u200b\u5de5\u4f5c\u200b\u6d41","text":"\ud83d\udcc4 \u200b\u7ea6\u200b 399 \u200b\u5b57\u200b\u23f1\ufe0f \u200b\u9605\u8bfb\u200b\u7ea6\u200b 1 \u200b\u5206\u949f\u200b <p>\u200b\u4e00\u4efd\u200b\u7ed9\u200b\u300c\u200b\u4e00\u4e2a\u200b\u4eba\u200b\u7ef4\u62a4\u200b\u4e00\u4e2a\u200b\u4ed3\u5e93\u200b\u300d\u200b\u573a\u666f\u200b\u7684\u200b\u7cbe\u7b80\u200b\u7ea6\u5b9a\u200b\uff0c\u200b\u4e0d\u200b\u8ffd\u6c42\u200b\u5b8c\u5907\u200b\uff0c\u200b\u53ea\u6c42\u200b\u80fd\u200b\u957f\u671f\u200b\u575a\u6301\u200b\u3002</p>","tags":["Git","\u5de5\u4f5c\u6d41"]},{"location":"notes/git-workflow/#\u5206\u652f\u6a21\u578b","title":"\u5206\u652f\u200b\u6a21\u578b","text":"<p>\u200b\u53ea\u6709\u200b\u4e24\u6761\u200b\u957f\u671f\u200b\u5206\u652f\u200b\uff1a</p> <ul> <li><code>main</code>\uff1a\u200b\u968f\u65f6\u200b\u53ef\u200b\u53d1\u5e03\u200b\u7684\u200b\u7248\u672c\u200b\uff0c\u200b\u6bcf\u6b21\u200b\u63a8\u9001\u200b\u90fd\u200b\u4f1a\u200b\u89e6\u53d1\u200b\u81ea\u52a8\u200b\u90e8\u7f72\u200b</li> <li><code>draft</code>\uff1a\u200b\u4e0d\u200b\u786e\u5b9a\u200b\u8981\u200b\u4e0d\u8981\u200b\u53d1\u200b\u7684\u200b\u5185\u5bb9\u200b\u6682\u200b\u5b58\u5728\u200b\u8fd9\u91cc\u200b</li> </ul> <p>\u200b\u5199\u200b\u4e00\u7bc7\u200b\u6587\u7ae0\u200b\u7684\u200b\u5b8c\u6574\u200b\u6d41\u7a0b\u200b\uff1a</p> <pre><code>git switch -c post/giscus-comments   # \u200b\u4ece\u200b main \u200b\u5f00\u200b\u5206\u652f\u200b\n# ... \u200b\u5199\u200b\u5185\u5bb9\u200b\u3001\u200b\u9884\u89c8\u200b\u3001\u200b\u4fee\u6539\u200b ...\ngit add -A\ngit commit -m \"post: \u200b\u7ed9\u200b\u9759\u6001\u200b\u535a\u5ba2\u200b\u63a5\u4e0a\u200b giscus \u200b\u8bc4\u8bba\u200b\"\ngit switch main\ngit merge --no-ff post/giscus-comments\ngit push\ngit branch -d post/giscus-comments\n</code></pre> <p>\u200b\u4e3a\u4ec0\u4e48\u200b\u7528\u200b --no-ff</p> <p>\u200b\u4fdd\u7559\u200b\u4e00\u6b21\u200b\u5408\u5e76\u200b\u63d0\u4ea4\u200b\uff0c\u200b\u5c06\u6765\u200b <code>git log --graph</code> \u200b\u80fd\u200b\u6e05\u695a\u200b\u770b\u5230\u200b\u300c\u200b\u54ea\u51e0\u4e2a\u200b\u63d0\u4ea4\u200b\u5c5e\u4e8e\u200b\u54ea\u200b\u7bc7\u6587\u7ae0\u200b\u300d\uff0c \u200b\u56de\u6eda\u65f6\u200b\u76f4\u63a5\u200b <code>git revert -m 1 &lt;merge&gt;</code> \u200b\u5373\u53ef\u200b\u3002</p>","tags":["Git","\u5de5\u4f5c\u6d41"]},{"location":"notes/git-workflow/#\u63d0\u4ea4\u4fe1\u606f\u7ea6\u5b9a","title":"\u63d0\u4ea4\u200b\u4fe1\u606f\u200b\u7ea6\u5b9a","text":"<pre><code>&lt;\u200b\u7c7b\u578b\u200b&gt;: &lt;\u200b\u4e00\u53e5\u200b\u8bdd\u200b\u8bf4\u660e\u200b&gt;\n</code></pre> \u200b\u7c7b\u578b\u200b \u200b\u7528\u9014\u200b <code>post</code> \u200b\u65b0\u589e\u200b\u6216\u5927\u6539\u200b\u4e00\u7bc7\u200b\u6587\u7ae0\u200b <code>fix</code> \u200b\u4fee\u6b63\u200b\u9519\u522b\u5b57\u200b\u3001\u200b\u574f\u200b\u94fe\u63a5\u200b\u3001\u200b\u4e8b\u5b9e\u200b\u9519\u8bef\u200b <code>style</code> \u200b\u53ea\u52a8\u200b\u6837\u5f0f\u200b\uff0c\u200b\u4e0d\u200b\u52a8\u200b\u5185\u5bb9\u200b <code>config</code> \u200b\u6539\u200b <code>mkdocs.yml</code>\u3001\u200b\u5de5\u4f5c\u200b\u6d41\u200b\u3001\u200b\u4f9d\u8d56\u200b <code>chore</code> \u200b\u5176\u5b83\u200b\u6742\u9879\u200b <p>\u200b\u4f8b\u5b50\u200b\uff1a</p> <pre><code>post: \u200b\u7528\u200b MkDocs Material \u200b\u642d\u200b\u4e00\u4e2a\u200b GitHub \u200b\u535a\u5ba2\u200b\nfix: \u200b\u4fee\u6b63\u200b giscus \u200b\u914d\u7f6e\u200b\u7ae0\u8282\u200b\u7684\u200b\u9519\u522b\u5b57\u200b\nconfig: \u200b\u641c\u7d22\u200b\u63d2\u4ef6\u200b\u542f\u7528\u200b\u4e2d\u6587\u200b\u5206\u8bcd\u200b\n</code></pre>","tags":["Git","\u5de5\u4f5c\u6d41"]},{"location":"notes/git-workflow/#\u51e0\u4e2a\u6709\u7528\u7684\u547d\u4ee4","title":"\u51e0\u4e2a\u200b\u6709\u7528\u200b\u7684\u200b\u547d\u4ee4","text":"<p>\u200b\u67e5\u770b\u200b\u67d0\u200b\u7bc7\u6587\u7ae0\u200b\u7684\u200b\u4fee\u6539\u200b\u5386\u53f2\u200b</p> <pre><code>git log --follow -p -- docs/blog/posts/comments-with-giscus.md\n</code></pre> <p>\u200b\u4e34\u65f6\u200b\u85cf\u8d77\u200b\u672a\u200b\u5199\u200b\u5b8c\u200b\u7684\u200b\u6539\u52a8\u200b</p> <pre><code>git stash push -m \"wip: \u200b\u4e00\u534a\u200b\u7684\u200b\u8349\u7a3f\u200b\"\ngit stash pop\n</code></pre> <p>\u200b\u627e\u51fa\u200b\u6240\u6709\u200b\u5931\u6548\u200b\u7684\u200b\u5185\u90e8\u200b\u94fe\u63a5\u200b\uff08\u200b\u6784\u5efa\u200b\u65f6\u4f1a\u200b\u81ea\u52a8\u200b\u6821\u9a8c\u200b\uff09</p> <pre><code>.venv\\Scripts\\mkdocs build --strict\n</code></pre>","tags":["Git","\u5de5\u4f5c\u6d41"]},{"location":"notes/git-workflow/#\u5199\u4f5c\u4e0e\u53d1\u5e03\u7684\u8fb9\u754c","title":"\u5199\u4f5c\u200b\u4e0e\u200b\u53d1\u5e03\u200b\u7684\u200b\u8fb9\u754c","text":"<p>\u200b\u4e00\u4e2a\u200b\u503c\u5f97\u200b\u575a\u6301\u200b\u7684\u200b\u539f\u5219\u200b\uff1a<code>main</code> \u200b\u5206\u652f\u200b\u4e0a\u200b\u7684\u200b\u5185\u5bb9\u200b\u5fc5\u987b\u200b\u662f\u200b\u53ef\u4ee5\u200b\u88ab\u200b\u516c\u5f00\u200b\u9605\u8bfb\u200b\u7684\u200b\u3002</p> <ul> <li>\u200b\u6ca1\u5199\u200b\u5b8c\u200b\u7684\u200b\u6587\u7ae0\u200b\u653e\u5728\u200b <code>draft</code> \u200b\u5206\u652f\u200b\uff0c\u200b\u6216\u8005\u200b\u7528\u200b front matter \u200b\u7684\u200b <code>draft: true</code> \u200b\u6807\u8bb0\u200b</li> <li>\u200b\u672c\u5730\u200b\u8dd1\u200b <code>mkdocs serve</code> \u200b\u65f6\u200b\u8349\u7a3f\u200b\u53ef\u89c1\u200b\uff08<code>draft_on_serve: true</code>\uff09\uff0c\u200b\u6784\u5efa\u200b\u53d1\u5e03\u200b\u65f6\u200b\u81ea\u52a8\u9690\u85cf\u200b</li> <li>\u200b\u4efb\u4f55\u200b\u300c\u200b\u6682\u65f6\u200b\u4e0d\u60f3\u200b\u88ab\u200b\u770b\u5230\u200b\u300d\u200b\u7684\u200b\u5185\u5bb9\u200b\uff0c\u200b\u4e0d\u8981\u200b\u63a8\u9001\u200b\u5230\u200b\u8fdc\u7aef\u200b\u4ed3\u5e93\u200b \u2014\u2014   \u200b\u5373\u4f7f\u200b\u4e4b\u540e\u200b\u5220\u6389\u200b\uff0c\u200b\u63d0\u4ea4\u200b\u5386\u53f2\u200b\u91cc\u200b\u4f9d\u7136\u200b\u80fd\u200b\u627e\u5230\u200b</li> </ul>","tags":["Git","\u5de5\u4f5c\u6d41"]},{"location":"notes/git-workflow/#\u5907\u4efd","title":"\u5907\u4efd","text":"<p>\u200b\u4ed3\u5e93\u200b\u540c\u65f6\u200b\u5b58\u5728\u200b\u4e09\u4e2a\u200b\u5730\u65b9\u200b\uff0c\u200b\u57fa\u672c\u200b\u4e0d\u7528\u200b\u62c5\u5fc3\u200b\u4e22\u5931\u200b\uff1a</p> <ol> <li>\u200b\u672c\u5730\u200b\u5de5\u4f5c\u200b\u526f\u672c\u200b</li> <li>GitHub \u200b\u8fdc\u7aef\u200b\u4ed3\u5e93\u200b</li> <li>\u200b\u6bcf\u6b21\u200b <code>git clone</code> \u200b\u51fa\u6765\u200b\u7684\u200b\u4efb\u4f55\u200b\u4e00\u53f0\u200b\u673a\u5668\u200b</li> </ol> <p>\u200b\u5982\u679c\u200b\u8fd8\u200b\u60f3\u200b\u66f4\u200b\u7a33\u59a5\u200b\uff0c\u200b\u53ef\u4ee5\u200b\u518d\u200b\u6302\u200b\u4e00\u4e2a\u200b\u79c1\u6709\u200b\u955c\u50cf\u200b\uff1a</p> <pre><code>git remote set-url --add --push origin git@github.com:your-name/blog-mirror.git\n</code></pre>","tags":["Git","\u5de5\u4f5c\u6d41"]},{"location":"blog/archive/2026/","title":"2026 \u200b\u5e74\u200b 10 \u200b\u6708","text":""},{"location":"blog/archive/2025/","title":"2025 \u200b\u5e74\u200b 01 \u200b\u6708","text":""},{"location":"blog/category/%E6%8A%98%E8%85%BE%E8%AE%B0%E5%BD%95/","title":"\u6298\u817e\u200b\u8bb0\u5f55","text":""}]}